{
  "helix-engine": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node /Users/mert/.gemini/config/plugins/helix/hooks/pre-invocation.mjs",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/mert/.gemini/config/plugins/helix/hooks/pre-tool-use.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "read_file",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/mert/.gemini/config/plugins/helix/hooks/pre-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/mert/.gemini/config/plugins/helix/hooks/post-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
