{
  "helix-engine": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node /Users/mert/.gemini/config/plugins/helix/hooks/session-start.mjs",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node /Users/mert/.gemini/config/plugins/helix/hooks/pre-invocation.mjs",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/mert/.gemini/config/plugins/helix/bin/pre_tool_use",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node /Users/mert/.gemini/config/plugins/helix/hooks/stop-monitor.mjs",
        "timeout": 10
      }
    ]
  }
}
