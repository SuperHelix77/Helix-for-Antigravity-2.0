#!/usr/bin/env python3
# outline F... : symbols as name:start-end ("[nodoc]" = no docstring) (python via ast; others via regex)
import sys,ast,re
for f in sys.argv[1:]:
    try: s=open(f).read()
    except Exception as e: print(f,e); continue
    out=[]
    if f.endswith('.py'):
        try:
            for n in ast.walk(ast.parse(s)):
                if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)):
                    ov=any((isinstance(d,ast.Name) and d.id=="overload") or (isinstance(d,ast.Attribute) and d.attr=="overload") for d in getattr(n,"decorator_list",[]))
                    out.append((n.lineno,f"{n.name}:{n.lineno}-{n.end_lineno}"+("[overload]" if ov else ("" if ast.get_docstring(n) else "[nodoc]"))))
        except SyntaxError as e: out.append((0,f'syntax error {e.lineno}'))
    else:
        for i,l in enumerate(s.split('\n'),1):
            m=re.match(r'\s*(?:export\s+)?(?:async\s+)?(?:function|class|def|fn|func|const|interface|type)\s+([A-Za-z_]\w*)',l)
            if m: out.append((i,f"{m.group(1)}:{i}"))
    print(f+': '+' '.join(x for _,x in sorted(out)))
